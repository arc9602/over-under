# =============================================================
# Over/Under — local environment
# This file is gitignored (.env* is in .gitignore). Never commit it.
#
# Paste your values to the right of each `=`. No quotes needed.
# Anything left as a PASTE_… placeholder is treated as "not configured yet".
# =============================================================


# -------------------------------------------------------------
# Supabase (existing — Phase 1/2). Project Settings → API.
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# -------------------------------------------------------------
# Privy (Phase 3). dashboard.privy.io → your app → Settings.
# -------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only. Used to verify Privy auth tokens in route handlers.
PRIVY_APP_SECRET=

# Optional but recommended: verifies Privy JWTs offline (no network round-trip
# per request), which matters on Cloudflare Workers. Same dashboard page.
PRIVY_VERIFICATION_KEY=


# -------------------------------------------------------------
# USDC custody kill switch (lib/chain/env.ts)
# -------------------------------------------------------------
# Blank or anything other than exactly "1" (the default) means the app is
# IOU-only: wallet linking, deposits, withdrawals and /api/bets/place all
# 404 -- not 403, so a prober cannot tell custody exists here at all -- and
# CreateMarketForm doesn't render the backing choice, so every market it
# creates is IOU-backed regardless of what a crafted request submits.
#
# Set to 1 to re-enable wallet linking, deposits, withdrawals, and
# USDC-backed markets.
#
# Deliberately off by default: the IOU ledger custodies nothing and is
# launching first, while the USDC vault below waits on legal review of the
# custody model. A fresh deploy or a missing env var must fail closed into
# IOU-only, not silently turn real-money custody back on.
NEXT_PUBLIC_ENABLE_USDC=


# -------------------------------------------------------------
# Chain — Polygon Amoy testnet
# -------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=80002

# RPC endpoint. The public https://rpc-amoy.polygon.technology works for light
# use but rate-limits hard; an Alchemy/Infura/QuickNode Amoy URL is better.
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology

# Server-side RPC. Can be the same URL, but keep it separate so the key used for
# withdrawals/verification isn't exposed in the browser bundle.
RPC_URL=https://rpc-amoy.polygon.technology

# Test USDC on Amoy. Circle's official testnet USDC is:
#   0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
# Replace if you're using your own mock ERC-20.
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582

# Decimals for the token above. USDC is 6 — change only if using a mock token.
NEXT_PUBLIC_USDC_DECIMALS=6


# -------------------------------------------------------------
# Platform vault
# -------------------------------------------------------------
# Public address users deposit to. Must be the address derived from
# VAULT_PRIVATE_KEY below — a mismatch means deposits land somewhere the
# withdrawal signer cannot spend from.
NEXT_PUBLIC_VAULT_ADDRESS=

# ⚠️  Server-only, and the single most sensitive value in this file. It can move
# every dollar in the vault. Use a THROWAWAY testnet key here. In production this
# belongs in `wrangler secret put`, not in any file. 0x-prefixed hex.
VAULT_PRIVATE_KEY=


# -------------------------------------------------------------
# CSRF same-origin check (lib/api/session.ts)
# -------------------------------------------------------------
# Optional. The route handlers that move money compare the browser's Origin
# (or Referer) against this app's own origin, normally worked out from the
# request itself. Only set this if, after a deploy, the money endpoints
# (wallet link/deposit/withdraw, bet placement, market settlement) start
# returning 403 "Cross-origin requests are not allowed" for real users -- that
# means Cloudflare Workers handed the handler a request whose URL/Host don't
# match what the browser actually addressed, and this is the explicit
# override. Must be the exact scheme+host+port the browser sees, e.g.
# https://over-under.example.com -- no path, no trailing slash.
APP_ORIGIN=


# -------------------------------------------------------------
# Content Security Policy (lib/security/headers.ts)
# -------------------------------------------------------------
# Blank (the default) sends the policy as Content-Security-Policy-Report-Only:
# violations show up in the browser console and nothing is blocked. Set to 1 to
# enforce it for real.
#
# Deliberately not enforced out of the box. The policy has never been exercised
# against a live Privy session, and a wrong connect-src or frame-src does not
# degrade the wallet -- it breaks it, leaving users unable to sign, deposit or
# withdraw. Flip this to 1 only after the console is clean through a full
# login -> link wallet -> deposit -> trade -> withdraw pass. Nothing else about
# the policy changes; enforcing swaps one header name.
CSP_ENFORCE=


# -------------------------------------------------------------
# Admin
# -------------------------------------------------------------
# Comma-separated Supabase user UUIDs allowed to force-settle a market via
# /api/markets/[id]/settle. Leave blank to disable the admin settle route.
ADMIN_USER_IDS=

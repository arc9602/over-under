# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the placeholder template, which holds no values. This negation
# must come after the .env* line above -- git applies the last matching
# pattern, so reversing these two lines silently un-tracks the template.
!.env.example

# vercel
.vercel

# cloudflare / opennext
.open-next
.wrangler
.dev.vars*
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored AI-tooling skill bundles.
#
# These are third-party content fetched by `npx impeccable install` and
# `npx skills add`, together about 4MB of markdown and scripts that nobody
# here edits. skills-lock.json is committed, so a fresh clone can reproduce
# them exactly; carrying the payload in git history would mean reviewing
# someone else's vendored files on every update for no benefit.
#
# .claude/agents/ is deliberately NOT ignored. It holds ui-builder.md, which
# is ours: it defines how agents are expected to work in this repo, and it
# should travel with the repo the way AGENTS.md does.
.claude/skills/
.agents/
.impeccable/hook.cache.json
